# LLM Wiki Environment Configuration
# Copy this file to .env and fill in the required values:
#   cp .env.example .env

# === AI Provider Configuration ===
# Recommended: manage providers and slot routing in the admin UI
# (System Settings -> General). Stored encrypted in DB, hot-refreshed without restart.
# The variable below is the legacy single-key fallback (passed through by docker-compose);
# it only takes effect when no DB/YAML provider config exists.
# Get your key at: https://dashscope.console.aliyun.com/
AI_DASHSCOPE_API_KEY=sk-your-key-here

# === Optional (defaults work out of the box) ===
# MYSQL_PASSWORD=llmwiki_2024
# MYSQL_ROOT_PASSWORD=llmwiki_root_2024
# JWT_SECRET=change-me-in-production
# Optional. Encryption key for AI provider API keys stored in the database (System Settings -> General).
# Defaults to a key derived from JWT_SECRET. Re-save all provider keys in the UI before rotating it,
# otherwise previously stored ciphertext can no longer be decrypted.
# AI_CONFIG_SECRET=
# ADMIN_USERNAMES=admin  # default admin username, password is printed in startup logs

# === Full mode only (docker-compose.full.yml) ===
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

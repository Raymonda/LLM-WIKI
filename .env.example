# LLM Wiki Environment Configuration
# Copy this file to .env and fill in the required values:
#   cp .env.example .env

# === AI Provider Configuration ===
# At least ONE provider API key must be configured.
# LLM Wiki supports any OpenAI-compatible API endpoint.

# DashScope (Alibaba Cloud) - default provider
# Get your key at: https://dashscope.console.aliyun.com/
AI_DASHSCOPE_API_KEY=sk-your-key-here

# DeepSeek (optional)
# Get your key at: https://platform.deepseek.com/
# AI_DEEPSEEK_API_KEY=sk-your-key-here

# Moonshot / Kimi (optional)
# Get your key at: https://platform.moonshot.cn/
# AI_MOONSHOT_API_KEY=sk-your-key-here

# OpenAI (optional)
# AI_OPENAI_API_KEY=sk-your-key-here

# Ollama / Local (optional)
# AI_LOCAL_BASE_URL=http://localhost:11434
# AI_LOCAL_API_KEY=ollama

# === Optional (defaults work out of the box) ===
# MYSQL_PASSWORD=llmwiki_2024
# MYSQL_ROOT_PASSWORD=llmwiki_root_2024
# JWT_SECRET=change-me-in-production
# ADMIN_USERNAMES=admin  # default admin username, password is printed in startup logs

# === Full mode only (docker-compose.full.yml) ===
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
